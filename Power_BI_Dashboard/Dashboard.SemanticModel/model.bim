                "    Source = Value.NativeQuery(Snowflake.Databases(\"qn44692.eu-central-2.aws.snowflakecomputing.com\",\"STREAMING_WH\"){[Name=\"STREAMING_DB\"]}[Data], \"SELECT#(lf)    'EARTHQUAKE' AS LOCATION_TYPE,#(lf)    UNID AS LOCATION_KEY,#(lf)    UNID AS LOCATION_NAME,#(lf)    LAT AS LATITUDE,#(lf)    LON AS LONGITUDE,#(lf)    MAG AS MAGNITUDE,#(lf)    DEPTH AS DEPTH_KM,#(lf)    TIME AS EVENT_TIME,#(lf)    NULL AS PORT_KEY,#(lf)    UNID AS EARTHQUAKE_KEY#(lf)FROM STREAMING_DB.KAFKA.EARTHQUAKES#(lf)#(lf)UNION ALL#(lf)#(lf)SELECT#(lf)    'PORT' AS LOCATION_TYPE,#(lf)    TO_VARCHAR(PORT_KEY) AS LOCATION_KEY,#(lf)    MAIN_PORT_NAME AS LOCATION_NAME,#(lf)    LATITUDE,#(lf)    LONGITUDE,#(lf)    NULL AS MAGNITUDE,#(lf)    NULL AS DEPTH_KM,#(lf)    NULL AS EVENT_TIME,#(lf)    PORT_KEY,#(lf)    NULL AS EARTHQUAKE_KEY#(lf)FROM STREAMING_DB.KAFKA.DIM_PORT\", null, [EnableFolding=true])",
                "in",
