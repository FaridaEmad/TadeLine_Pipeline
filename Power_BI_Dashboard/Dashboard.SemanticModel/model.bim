        "partitions": [
          {
            "name": "MapHelperTable",
            "mode": "directQuery",
            "source": {
              "expression": [
                "let",
                "    Source = Value.NativeQuery(Snowflake.Databases(\"qn44692.eu-central-2.aws.snowflakecomputing.com\",\"STREAMING_WH\"){[Name=\"STREAMING_DB\"]}[Data], \"SELECT#(lf)    'EARTHQUAKE' AS LOCATION_TYPE,#(lf)#(lf)    E.UNID AS LOCATION_KEY,#(lf)    E.UNID AS LOCATION_NAME,#(lf)#(lf)    E.LAT AS LATITUDE,#(lf)    E.LON AS LONGITUDE,#(lf)#(lf)    E.MAG AS MAGNITUDE,#(lf)    E.DEPTH AS DEPTH_KM,#(lf)    E.TIME AS EVENT_TIME,#(lf)#(lf)    MAX(F.RISK_RADIUS_KM) AS RISK_RADIUS_KM,#(lf)#(lf)    /* Bubble size for Power BI */#(lf)    MAX(F.RISK_RADIUS_KM) AS MAP_SIZE,#(lf)#(lf)    NULL::NUMBER AS PORT_KEY,#(lf)#(lf)    E.UNID AS EARTHQUAKE_KEY,#(lf)#(lf)    E.FLYNN_REGION,#(lf)    E.MAGTYPE,#(lf)#(lf)    NULL::VARCHAR AS COUNTRY_CODE,#(lf)    NULL::VARCHAR AS REGION_NAME,#(lf)    NULL::VARCHAR AS HARBOR_SIZE,#(lf)    NULL::VARCHAR AS HARBOR_TYPE#(lf)#(lf)FROM STREAMING_DB.KAFKA.EARTHQUAKES E#(lf)#(lf)LEFT JOIN STREAMING_DB.KAFKA.FACT_EARTHQUAKE_PORT_RISK F#(lf)    ON E.UNID = TO_VARCHAR(F.EARTHQUAKE_KEY)#(lf)#(lf)GROUP BY#(lf)    E.UNID,#(lf)    E.LAT,#(lf)    E.LON,#(lf)    E.MAG,#(lf)    E.DEPTH,#(lf)    E.TIME,#(lf)    E.FLYNN_REGION,#(lf)    E.MAGTYPE#(lf)#(lf)#(lf)UNION ALL#(lf)#(lf)#(lf)/* ============================================================#(lf)   PORTS#(lf)   One row per port#(lf)   ============================================================ */#(lf)#(lf)SELECT#(lf)    'PORT' AS LOCATION_TYPE,#(lf)#(lf)    TO_VARCHAR(P.PORT_KEY) AS LOCATION_KEY,#(lf)    P.MAIN_PORT_NAME AS LOCATION_NAME,#(lf)#(lf)    P.LATITUDE AS LATITUDE,#(lf)    P.LONGITUDE AS LONGITUDE,#(lf)#(lf)    NULL::FLOAT AS MAGNITUDE,#(lf)    NULL::FLOAT AS DEPTH_KM,#(lf)    NULL::TIMESTAMP_NTZ AS EVENT_TIME,#(lf)#(lf)    NULL::FLOAT AS RISK_RADIUS_KM,#(lf)#(lf)    /* Fixed small bubble for ports */#(lf)    5 AS MAP_SIZE,#(lf)#(lf)    P.PORT_KEY AS PORT_KEY,#(lf)#(lf)    NULL::VARCHAR AS EARTHQUAKE_KEY,#(lf)#(lf)    NULL::VARCHAR AS FLYNN_REGION,#(lf)    NULL::VARCHAR AS MAGTYPE,#(lf)#(lf)    P.COUNTRY_CODE,#(lf)    P.REGION_NAME,#(lf)    P.HARBOR_SIZE,#(lf)    P.HARBOR_TYPE#(lf)#(lf)FROM STREAMING_DB.KAFKA.DIM_PORT P\", null, [EnableFolding=true]),",
                "    #\"Replaced Value\" = Table.ReplaceValue(Source,null,5,Replacer.ReplaceValue,{\"MAP_SIZE\"}),",
                "    #\"Replaced Value1\" = Table.ReplaceValue(#\"Replaced Value\",null,5,Replacer.ReplaceValue,{\"RISK_RADIUS_KM\"})",
                "in",
                "    #\"Replaced Value1\""
              ],
              "type": "m"
            }
          }
        ]
      }
