        "lineageTag": "27e7b4f2-1c76-4c31-bae5-c3cfea4b509b",
        "measures": [
          {
            "name": "Total_Earthquakes",
            "expression": "DISTINCTCOUNT(EARTHQUAKES[UNID])",
            "formatString": "0",
            "lineageTag": "279f3930-3a73-4638-9296-4d5b96a668be"
          },
          {
            "name": "Earthquakes Last 24H",
            "expression": [
              "",
              "VAR LatestEarthquakeTime =",
              "    MAX(EARTHQUAKES[TIME])",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT(EARTHQUAKES[UNID]),",
              "    FILTER(",
              "        ALL(EARTHQUAKES),",
              "        EARTHQUAKES[TIME] >= LatestEarthquakeTime - 1",
              "            &&",
              "        EARTHQUAKES[TIME] <= LatestEarthquakeTime",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "227d7526-21c2-47c3-9d5f-8f186fdb068f"
          }
        ],
        "partitions": [
          {
            "name": "EARTHQUAKES",
            "mode": "directQuery",
            "source": {
              "expression": [
                "let",
                "    Source = Value.NativeQuery(Snowflake.Databases(\"qn44692.eu-central-2.aws.snowflakecomputing.com\",\"STREAMING_WH\"){[Name=\"STREAMING_DB\"]}[Data], \"SELECT#(lf)    UNID,#(lf)    SOURCE_ID,#(lf)    SOURCE_CATALOG,#(lf)    LASTUPDATE,#(lf)    TIME,#(lf)    FLYNN_REGION,#(lf)    LAT,#(lf)    LON,#(lf)    DEPTH,#(lf)    EVTYPE,#(lf)    AUTH,#(lf)    MAG,#(lf)    MAGTYPE,#(lf)    ACTION,#(lf)    RECEIVED_AT,#(lf)    EVENT_DATE,#(lf)#(lf)    TO_NUMBER(TO_CHAR(LASTUPDATE, 'YYYYMMDD'))#(lf)        AS LAST_UPDATE_DATE_KEY,#(lf)#(lf)    TO_NUMBER(TO_CHAR(LASTUPDATE, 'HH24MISS'))#(lf)        AS LAST_UPDATE_TIME_KEY,#(lf)#(lf)    TO_NUMBER(TO_CHAR(TIME, 'YYYYMMDD'))#(lf)        AS TIME_DATE_KEY,#(lf)#(lf)    TO_NUMBER(TO_CHAR(TIME, 'HH24MISS'))#(lf)        AS TIME_TIME_KEY,#(lf)#(lf)    TO_NUMBER(TO_CHAR(EVENT_DATE, 'YYYYMMDD'))#(lf)        AS EVENT_DATE_KEY#(lf)#(lf)FROM STREAMING_DB.KAFKA.earthquakes\", null, [EnableFolding=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"TIME\", type datetime}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
